{
  "cli": {
    "version": ">= 20.4.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "GRADLE_WORKERS_MAX": "4"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "GRADLE_WORKERS_MAX": "4"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "GRADLE_WORKERS_MAX": "4"
      }
    },
    "apk-preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "GRADLE_WORKERS_MAX": "4"
      }
    },
    "view": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "GRADLE_WORKERS_MAX": "4"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
