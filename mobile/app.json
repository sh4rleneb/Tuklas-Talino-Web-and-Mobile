{
  "expo": {
    "name": "Tuklas Talino",
    "slug": "tuklas-talino",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "extra": {
      "apiUrl": "http://47.131.121.7:4000/api",
      "eas": {
        "projectId": "93a4e1d3-a8a3-4b2d-a66d-ed1c618dba56"
      }
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-av",
        {
          "microphonePermission": "Allow Tuklas Talino to access your microphone for speech activities."
        }
      ],
      "expo-font"
    ],
    "android": {
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "package": "com.anonymous.tuklastalino",
      "softwareKeyboardLayoutMode": "pan",
      "icon": "./assets/tuklas-talino-icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/tuklas-talino-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "icon": "./assets/tuklas-talino-icon.png"
  }
}
